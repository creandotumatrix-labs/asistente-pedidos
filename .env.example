# ─── Shared runtime ────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
MODEL=claude-sonnet-4-6
PORT=8080
# Public HTTPS URL the channel posts webhooks to (ngrok / Render / Fly).
PUBLIC_URL=https://your-subdomain.ngrok-free.app

# Which business is LIVE. Flip this ONE line to change industries.
#   taqueria-el-pastor  → CDMX taquería: ordering, upsell, reservations, kitchen ticket
#   la-mesa-fina        → fine-dining persona (same restaurant engine, different voice)
#   inmobiliaria-cdmx   → real-estate agent (the white-label proof: same backend, new business)
BUSINESS=taqueria-el-pastor

# ─── Channel: pick ONE for the live demo ───────────────────────────
# twilio | meta | none   (none = simulator only, no WhatsApp)
CHANNEL=twilio

# Twilio WhatsApp Sandbox — fastest path to a real number for tomorrow.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_VALIDATE_SIGNATURE=true

# Meta WhatsApp Cloud API — free test number, also instant.
META_PHONE_NUMBER_ID=000000000000000
META_ACCESS_TOKEN=EAAxxxxxxxx
META_VERIFY_TOKEN=pick-any-string-and-paste-it-in-the-meta-dashboard
META_GRAPH_VERSION=v22.0
